# mysql 配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=test
MYSQL_CHARSET=utf8mb4

# 服务器发送验证码使用的邮箱
SEND_EMAIL="your_email@example.com"
SEND_PASSWORD="your_email_password"

# 配置Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# JWT相关 配置
# 密钥
SECRET_KEY="JWT_SECRET_KEY"
# 算法
ALGORITHM="HS256"
# token过期时间 这里的单位是秒 3600s=1h
ACCESS_TOKEN_EXPIRE=36000

# ============================================
# Docker 部署相关配置
# ============================================

# Ollama 配置
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Embedding 模型配置
EMBEDDING_MODEL_PATH=D:\Model\models\paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=cuda

# Reranker 模型配置
RERANKER_MODEL_PATH=D:\Model\models\bge-reranker-large
RERANKER_DEVICE=cuda
RERANKER_USE_FP16=True

# ChromaDB 配置
CHROMA_PERSIST_DIR=D:\Project1\final_rag\data\herbal_medicine_data
CHROMA_COLLECTION_NAME=herbal_medicine_data

# 聊天记忆数据库路径
CHAT_MEMORY_DB_PATH=D:/Project1/final_rag/data/chat_memory_db

# RAG 数据源路径（构建数据库时使用）
RAG_DATA_DIR=D:\RAG_DATA\herb_dataset